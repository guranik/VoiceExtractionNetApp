<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech Client" Height="600" Width="900"
        MinHeight="500" MinWidth="700">
    <Window.Resources>
        <!-- Стиль для обычных кнопок -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DEE2E6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CED4DA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для основной кнопки (Send) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0D6EFD"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B5ED7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0A56BE"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#6C757D"/>
                    <Setter Property="BorderBrush" Value="#6C757D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="Select WAV"
                    FontSize="16"
                    Padding="16,8"
                    Width="160"
                    Command="{Binding SelectFileCommand}"
                    Style="{StaticResource ModernButtonStyle}"/>

            <Button Content="Output Folder"
                    FontSize="16"
                    Padding="16,8"
                    Width="160"
                    Margin="20,0,0,0"
                    Command="{Binding SelectOutputDirCommand}"
                    Style="{StaticResource ModernButtonStyle}"/>

            <Button Content="Send"
                    FontSize="16"
                    Padding="16,8"
                    Width="160"
                    Margin="20,0,0,0"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding CanSend}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <!-- Прогресс и лог -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Двойной прогресс-бар -->
            <Grid Height="30" Margin="0,0,0,15">
                <ProgressBar Minimum="0" Maximum="1"
                             Value="{Binding ExtractProgress}"
                             Foreground="IndianRed"
                             Background="#33000000"
                             BorderThickness="0" />

                <ProgressBar Minimum="0" Maximum="1"
                             Value="{Binding TranscribeProgress}"
                             Foreground="DodgerBlue"
                             Background="Transparent"
                             BorderThickness="0" />
            </Grid>

            <!-- Поле лога -->
            <TextBox Grid.Row="1"
                     Text="{Binding Log}"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     Padding="12"
                     Background="#F8F9FA"
                     BorderBrush="#DDDDDD"
                     BorderThickness="1"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True" />
        </Grid>
    </Grid>
</Window>